-- =============================================
--  GUI — FIXED INITIALIZATION
-- =============================================

-- Ensure PlayerGui is available
local player = Players.LocalPlayer
local pgui = player:WaitForChild("PlayerGui", 10)

-- Clean up old GUI
local oldGui = pgui:FindFirstChild("AutoFarmGUI")
if oldGui then oldGui:Destroy() end

-- Create ScreenGui with safer parenting
local sg = Instance.new("ScreenGui")
sg.Name = "AutoFarmGUI"
sg.ResetOnSpawn = false
sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
sg.Enabled = true
sg.Parent = pgui -- Parent to PlayerGui

-- Color palette
local C = {
    bg       = Color3.fromRGB(16, 16, 22),
    accent1  = Color3.fromRGB(120, 90, 255),
    text     = Color3.fromRGB(255, 255, 255)
}

-- Floating Button
local floatBtn = Instance.new("TextButton", sg)
floatBtn.Size = UDim2.new(0, 44, 0, 44)
floatBtn.Position = UDim2.new(0, 8, 0.35, 0)
floatBtn.BackgroundColor3 = C.accent1
floatBtn.Text = ""
floatBtn.BorderSizePixel = 0
floatBtn.ZIndex = 100
Instance.new("UICorner", floatBtn).CornerRadius = UDim.new(0, 14)

-- Icon label
local floatIcon = Instance.new("TextLabel", floatBtn)
floatIcon.Size = UDim2.new(1,0,1,0)
floatIcon.BackgroundTransparency = 1
floatIcon.Text = "AF"
floatIcon.TextColor3 = C.text
floatIcon.TextSize = 14
floatIcon.Font = Enum.Font.GothamBold
floatIcon.ZIndex = 101

-- Toggle Visibility Logic
floatBtn.MouseButton1Click:Connect(function()
    if mainFrame then
        mainFrame.Visible = not mainFrame.Visible
    end
end)

-- Placeholder for mainFrame (Ensure this is built before the loop ends)
mainFrame = Instance.new("Frame", sg)
mainFrame.Size = UDim2.new(0, 200, 0, 300)
mainFrame.Position = UDim2.new(0, 60, 0, 100)
mainFrame.BackgroundColor3 = C.bg
mainFrame.Visible = false -- Hidden by default
Instance.new("UICorner", mainFrame)

-- Start the loops
task.spawn(farmLoop)
task.spawn(raidCycleLoop)
task.spawn(victoryLoop)
task.spawn(utilityLoop)

print("[AF] GUI initialized successfully.")
